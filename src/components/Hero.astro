---
import type { i18n } from '../types';

interface Props {
  t: i18n;
}

const { t } = Astro.props;
---

<section class="pt-20 pb-16 md:pt-32 md:pb-24">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-4">{t.title}</h1>
    <p class="text-lg md:text-xl text-[var(--color-secondary)] mb-6 max-w-2xl mx-auto">{t.subtitle}</p>
    <p class="text-sm text-[var(--color-secondary)] mb-12 max-w-xl mx-auto">{t.heroDesc}</p>

    <!-- Install boxes -->
    <div class="grid md:grid-cols-2 gap-4 max-w-3xl mx-auto mb-10">
      <!-- Human install -->
      <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-outline)] p-5 text-left">
        <div class="text-xs font-semibold uppercase tracking-wider text-[var(--color-accent)] mb-3">{t.humanLabel}</div>
        <div class="flex items-center justify-between bg-[var(--color-bg)] rounded-lg px-4 py-3">
          <code class="font-mono text-sm text-[var(--color-on-surface)] whitespace-nowrap overflow-x-auto">{t.humanInstall}</code>
          <button
            class="ml-3 shrink-0 text-xs text-[var(--color-secondary)] hover:text-[var(--color-on-surface)] transition-colors copy-btn"
            data-copy={t.humanInstall}
          >{t.copyButton}</button>
        </div>
      </div>

      <!-- AI install -->
      <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-outline)] p-5 text-left">
        <div class="text-xs font-semibold uppercase tracking-wider text-[var(--color-accent)] mb-3">{t.aiLabel}</div>
        <div class="flex items-start justify-between bg-[var(--color-bg)] rounded-lg px-4 py-3">
          <code class="font-mono text-xs leading-relaxed text-[var(--color-on-surface)] break-all">{t.aiInstall}</code>
          <button
            class="ml-3 shrink-0 text-xs text-[var(--color-secondary)] hover:text-[var(--color-on-surface)] transition-colors copy-btn"
            data-copy={t.aiInstall}
          >{t.copyButton}</button>
        </div>
      </div>
    </div>

    <!-- Badges -->
    <div class="flex flex-wrap justify-center gap-2 text-xs">
      <span class="px-3 py-1 rounded-full bg-[var(--color-surface)] border border-[var(--color-outline)] text-[var(--color-secondary)]">{t.badgeVersion}</span>
      <span class="px-3 py-1 rounded-full bg-[var(--color-surface)] border border-[var(--color-outline)] text-[var(--color-secondary)]">{t.badgeNode}</span>
      <span class="px-3 py-1 rounded-full bg-[var(--color-surface)] border border-[var(--color-outline)] text-[var(--color-secondary)]">{t.badgeLicense}</span>
      <span class="px-3 py-1 rounded-full bg-[var(--color-surface)] border border-[var(--color-outline)] text-[var(--color-secondary)]">{t.badgeAgents}</span>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy');
      if (!text) return;
      await navigator.clipboard.writeText(text);
      const original = btn.textContent;
      btn.textContent = btn.textContent === 'Copy' ? 'Copied!' : '已复制!';
      btn.classList.add('animate-copied');
      setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('animate-copied');
      }, 1500);
    });
  });
</script>
