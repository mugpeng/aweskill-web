---
import type { i18n } from '../types';

interface Props {
  t: i18n;
  title: string;
  date: string;
  readTime: string;
  lang: 'en' | 'zh';
}

const { t, title, date, readTime, lang } = Astro.props;
---

<article class="max-w-6xl mx-auto px-6 py-16">
  <!-- Article Hero -->
  <header class="mb-12 pb-8 border-b border-[var(--color-outline)]">
    <h1 class="text-3xl sm:text-4xl font-bold leading-tight tracking-tight text-gradient-hero mb-6">
      {title}
    </h1>
    <div class="flex flex-wrap items-center gap-3 text-sm text-[var(--color-secondary)]">
      <time datetime={date}>{date}</time>
      <span class="w-1 h-1 rounded-full bg-[var(--color-outline)]"></span>
      <span>{readTime}</span>
      <span class="w-1 h-1 rounded-full bg-[var(--color-outline)]"></span>
      <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-[var(--color-surface)] border border-[var(--color-outline)]">
        {lang === 'en' ? 'EN' : '中文'}
      </span>
    </div>
  </header>

  <!-- Content + TOC -->
  <div class="flex gap-12">
    <!-- Main Content -->
    <div class="article-content flex-1 min-w-0 max-w-[720px]">
      <slot />
    </div>

    <!-- TOC Sidebar -->
    <aside class="hidden lg:block w-60 shrink-0">
      <div class="sticky top-24">
        <slot name="toc" />
      </div>
    </aside>
  </div>
</article>
