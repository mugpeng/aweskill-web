---
import type { i18n } from '../types';

interface Props {
  t: i18n;
  isArticle?: boolean;
  langHrefOverride?: string;
}

const { t, isArticle = false, langHrefOverride } = Astro.props;
const langHref = langHrefOverride ?? (isArticle ? t.langSwitchArticleHref : t.langSwitchHref);
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[var(--color-bg)]/80 border-b border-[var(--color-outline)]">
  <div class="max-w-6xl mx-auto px-3 sm:px-6 h-16 sm:h-18 flex items-center justify-between gap-3">
    <a href={t.homeHref} class="flex items-center gap-2.5 font-semibold text-[var(--color-on-surface)] shrink-0" aria-label="aweskill home">
      <img src="/logo.png" alt="aweskill" class="h-9 w-9 sm:h-10 sm:w-10 rounded-lg" />
      <span class="hidden sm:inline text-xl tracking-tight font-semibold">aweskill</span>
    </a>
    <nav class="flex items-center justify-end gap-1.5 sm:gap-3 min-w-0">
      <a href={t.newsHref} class="px-1.5 sm:px-2 py-1 text-sm font-medium text-[var(--color-secondary)] hover:text-[var(--color-on-surface)] transition-colors rounded-md hover:bg-[var(--color-surface)]">
        {t.newsLabel}
      </a>
      <div class="hidden min-[380px]:block w-px h-5 bg-[var(--color-outline)]"></div>
      <button id="theme-toggle" class="p-1.5 text-[var(--color-secondary)] hover:text-[var(--color-on-surface)] transition-colors" aria-label="Toggle theme">
        <svg class="w-5 h-5 hidden dark-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72 1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg class="w-5 h-5 light-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <a href={langHref} class="px-1.5 sm:px-2 py-1 text-sm font-medium text-[var(--color-secondary)] hover:text-[var(--color-on-surface)] transition-colors rounded-md hover:bg-[var(--color-surface)]">
        {t.langSwitch}
      </a>
      <div class="hidden min-[380px]:block w-px h-5 bg-[var(--color-outline)]"></div>
      <a href="https://github.com/mugpeng/aweskill" target="_blank" rel="noopener" class="github-star-btn flex items-center gap-2 px-2 sm:px-4 py-2 rounded-lg text-[var(--color-secondary)] hover:text-[var(--color-accent)] bg-[var(--color-surface)] border border-[var(--color-outline)] hover:border-[var(--color-accent)]/30 transition-all duration-300 group" aria-label="Star on GitHub">
        <svg class="w-5 h-5 group-hover:scale-110 transition-transform" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
        <span class="text-sm font-mono font-medium hidden sm:inline">Star</span>
      </a>
    </nav>
  </div>
</header>
