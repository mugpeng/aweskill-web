---
import type { i18n } from '../types';

interface Props {
  t: i18n;
}

const { t } = Astro.props;
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[var(--color-bg)]/80 border-b border-[var(--color-outline)]">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href={t.langSwitchHref === '/' ? '/' : '/zh'} class="flex items-center gap-2.5 font-semibold text-[var(--color-on-surface)]">
      <img src="/logo.png" alt="aweskill" class="h-9 w-9 rounded-lg" />
      <span class="text-lg tracking-tight">aweskill</span>
    </a>
    <nav class="flex items-center gap-4">
      <button id="theme-toggle" class="text-[var(--color-secondary)] hover:text-[var(--color-on-surface)] transition-colors" aria-label="Toggle theme">
        <svg class="w-5 h-5 hidden dark-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72 1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg class="w-5 h-5 light-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <a href={t.langSwitchHref} class="text-base text-[var(--color-secondary)] hover:text-[var(--color-on-surface)] transition-colors">
        {t.langSwitch}
      </a>
      <a href="https://github.com/mugpeng/aweskill" target="_blank" rel="noopener" class="text-[var(--color-secondary)] hover:text-[var(--color-on-surface)] transition-colors" aria-label="GitHub">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.605-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12"/></svg>
      </a>
    </nav>
  </div>
</header>
