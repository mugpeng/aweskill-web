---
import type { i18n } from '../types';

interface Props {
  t: i18n;
}

const { t } = Astro.props;

const agents = [
  'Claude Code', 'Cursor', 'Codex', 'Gemini CLI',
  'Windsurf', 'Cline', 'Aider', 'Copilot',
  'Continue', 'OpenCode', 'Zed', 'Amp',
];
---

<section class="py-16 md:py-20">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-10">{t.agentsTitle}</h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-4">
      {agents.map(name => (
        <div class="glow-card px-4 py-5 text-base font-medium text-[var(--color-secondary)] hover:text-[var(--color-accent)] transition-colors cursor-default">
          {name}
        </div>
      ))}
    </div>
    <p class="mt-8 text-base text-[var(--color-secondary)]">+ 35 more</p>
  </div>
</section>
