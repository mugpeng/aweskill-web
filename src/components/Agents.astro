---
import type { i18n } from '../types';

interface Props {
  t: i18n;
}

const { t } = Astro.props;

const agents = [
  'Claude Code', 'Cursor', 'Codex', 'Gemini CLI',
  'Windsurf', 'Cline', 'Aider', 'Copilot',
  'Continue', 'OpenCode', 'Zed', 'Amp',
];
---

<section class="py-20 md:py-28">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-16">{t.agentsTitle}</h2>
    <p class="text-base md:text-lg text-[var(--color-secondary)] max-w-2xl mx-auto mb-10">{t.agentsCaption}</p>
    <div class="agent-grid">
      {agents.map((name, index) => (
        <div class={`glow-card agent-chip agent-chip--${index % 4}`} >
          <span class="agent-chip__signal"></span>
          <span>{name}</span>
        </div>
      ))}
    </div>
    <div class="agent-summary mt-8">
      <span class="agent-summary__pill">live links</span>
      <span class="agent-summary__copy">+ 35 more environments available</span>
    </div>
  </div>
</section>
