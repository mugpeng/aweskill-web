---
import type { i18n } from '../types';

interface Props {
  t: i18n;
}

const { t } = Astro.props;

const features = [
  { icon: '>', title: t.featureInstallTitle, desc: t.featureInstallDesc },
  { icon: '{}', title: t.featureBundleTitle, desc: t.featureBundleDesc },
  { icon: '~>', title: t.featureProjectTitle, desc: t.featureProjectDesc },
  { icon: '+', title: t.featureDoctorTitle, desc: t.featureDoctorDesc },
];
---

<section class="py-20 md:py-28">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-center mb-16">{t.featuresTitle}</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {features.map(f => (
        <div class="glow-card scanline-overlay p-7">
          <div class="font-mono text-2xl text-[var(--color-accent)] mb-4">{f.icon}</div>
          <h3 class="text-lg font-semibold mb-2 text-[var(--color-on-surface)]">{f.title}</h3>
          <p class="text-base text-[var(--color-secondary)] leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
