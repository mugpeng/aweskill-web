---
import type { i18n } from '../types';

interface Props {
  t: i18n;
}

const { t } = Astro.props;
---

<section class="py-16 md:py-20">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-center mb-6">{t.comparisonTitle}</h2>
    <p class="text-base md:text-lg text-[var(--color-secondary)] text-center mb-8 max-w-2xl mx-auto">{t.comparisonSubtitle}</p>

    <div class="terminal-box overflow-x-auto">
      <div class="terminal-header">
        <span class="terminal-dot terminal-dot--red"></span>
        <span class="terminal-dot terminal-dot--yellow"></span>
        <span class="terminal-dot terminal-dot--green"></span>
        <span class="ml-2 text-xs font-mono text-[var(--color-secondary)] tracking-wide uppercase">{t.comparisonHeader}</span>
      </div>
      <div class="terminal-body">
        <table class="w-full border-collapse font-mono text-sm">
          <thead>
            <tr class="border-b border-[var(--color-outline)]">
              <th class="text-left py-3 pr-4 text-[var(--color-secondary)] font-medium">{t.colCapability}</th>
              <th class="text-center py-3 px-4 text-[var(--color-secondary)] font-medium min-w-[140px]">{t.colManual}</th>
              <th class="text-center py-3 px-4 text-[var(--color-secondary)] font-medium min-w-[140px]">{t.colOthers}</th>
              <th class="text-center py-3 px-4 bg-[var(--color-accent)]/5 border-l-2 border-r-2 border-[var(--color-accent)]/20 text-[var(--color-accent)] font-semibold min-w-[120px]">aweskill</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-[var(--color-outline)]/50">
              <td class="py-3 pr-4 text-[var(--color-on-surface)]">{t.rowCentralStore}</td>
              <td class="text-center py-3 px-4 text-[var(--color-secondary)]">✗</td>
              <td class="text-center py-3 px-4 text-[var(--color-secondary)] text-xs leading-relaxed">{t.rowCentralStoreOthers}</td>
              <td class="text-center py-3 px-4 bg-[var(--color-accent)]/5 border-l-2 border-r-2 border-[var(--color-accent)]/20 text-[var(--color-accent)] font-semibold">✓</td>
            </tr>
            <tr class="border-b border-[var(--color-outline)]/50">
              <td class="py-3 pr-4 text-[var(--color-on-surface)]">{t.rowRegistry}</td>
              <td class="text-center py-3 px-4 text-[var(--color-secondary)]">✗</td>
              <td class="text-center py-3 px-4 text-[var(--color-secondary)] text-xs leading-relaxed">{t.rowRegistryOthers}</td>
              <td class="text-center py-3 px-4 bg-[var(--color-accent)]/5 border-l-2 border-r-2 border-[var(--color-accent)]/20 text-[var(--color-accent)] font-semibold">✓</td>
            </tr>
            <tr class="border-b border-[var(--color-outline)]/50">
              <td class="py-3 pr-4 text-[var(--color-on-surface)]">{t.rowMultiAgent}</td>
              <td class="text-center py-3 px-4 text-[var(--color-secondary)]">✗</td>
              <td class="text-center py-3 px-4 text-[var(--color-secondary)] text-xs leading-relaxed">{t.rowMultiAgentOthers}</td>
              <td class="text-center py-3 px-4 bg-[var(--color-accent)]/5 border-l-2 border-r-2 border-[var(--color-accent)]/20 text-[var(--color-accent)] font-semibold">✓</td>
            </tr>
            <tr class="border-b border-[var(--color-outline)]/50">
              <td class="py-3 pr-4 text-[var(--color-on-surface)]">{t.rowBundle}</td>
              <td class="text-center py-3 px-4 text-[var(--color-secondary)]">✗</td>
              <td class="text-center py-3 px-4 text-[var(--color-secondary)] text-xs leading-relaxed">{t.rowBundleOthers}</td>
              <td class="text-center py-3 px-4 bg-[var(--color-accent)]/5 border-l-2 border-r-2 border-[var(--color-accent)]/20 text-[var(--color-accent)] font-semibold">✓</td>
            </tr>
            <tr class="border-b border-[var(--color-outline)]/50">
              <td class="py-3 pr-4 text-[var(--color-on-surface)]">{t.rowSelfUpdate}</td>
              <td class="text-center py-3 px-4 text-[var(--color-secondary)]">✗</td>
              <td class="text-center py-3 px-4 text-[var(--color-secondary)] text-xs leading-relaxed">{t.rowSelfUpdateOthers}</td>
              <td class="text-center py-3 px-4 bg-[var(--color-accent)]/5 border-l-2 border-r-2 border-[var(--color-accent)]/20 text-[var(--color-accent)] font-semibold">✓</td>
            </tr>
            <tr class="last:border-0">
              <td class="py-3 pr-4 text-[var(--color-on-surface)]">{t.rowDoctor}</td>
              <td class="text-center py-3 px-4 text-[var(--color-secondary)]">✗</td>
              <td class="text-center py-3 px-4 text-[var(--color-secondary)] text-xs leading-relaxed">{t.rowDoctorOthers}</td>
              <td class="text-center py-3 px-4 bg-[var(--color-accent)]/5 border-l-2 border-r-2 border-[var(--color-accent)]/20 text-[var(--color-accent)] font-semibold">✓</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
