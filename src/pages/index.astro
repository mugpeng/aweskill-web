---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Comparison from '../components/Comparison.astro';
import Agents from '../components/Agents.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import t from '../i18n/en.json';
---

<Layout lang="en" title="aweskill — Skill Package Manager for AI Agents" description="CLI-first skill package manager that AI agents can operate themselves. One install, many coding agents.">
  <Header t={t} />
  <main>
    <Hero t={t} />
    <Features t={t} />
    <Comparison t={t} />
    <Agents t={t} />
  </main>
  <Footer t={t} />
</Layout>
